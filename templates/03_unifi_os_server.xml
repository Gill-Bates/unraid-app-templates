  <!-- Configurations -->
  <Config Name="UOS System IP/Hostname" Target="UOS_SYSTEM_IP" Default="" Mode="" Description="REQUIRED: IP address or hostname of your Docker host (e.g. 192.168.1.10). Used for UniFi device adoption and remote management." Type="Variable" Display="always" Required="true" Mask="false" />
  <Config Name="Hardware Platform" Target="HARDWARE_PLATFORM" Default="|synology" Mode="" Description="Leave empty for standard hardware, or set to 'synology' if running on a Synology NAS." Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Show systemd journal in Docker logs" Target="UOS_SHOW_JOURNAL" Default="false|true" Mode="" Description="Forward the full systemd journal to Docker logs. Default false shows only the startup banner and entrypoint summary." Type="Variable" Display="always" Required="false" Mask="false">false</Config>
  <Config Name="Timezone" Target="TZ" Default="UTC" Mode="" Description="Container timezone (e.g. UTC, Europe/Berlin)" Type="Variable" Display="always" Required="false" Mask="false" />
  <Config Name="UniFi OS Server GUI" Target="443" Default="11443" Mode="tcp" Description="UniFi OS Server GUI/API Port (container listens on 443, mapped to host port 11443)" Type="Port" Display="always" Required="true" Mask="false" />
  <Config Name="Device Communication" Target="8080" Default="8080" Mode="tcp" Description="Device and application communication port (required for adoption)" Type="Port" Display="always" Required="true" Mask="false" />
  <Config Name="UniFi Network App" Target="8443" Default="8443" Mode="tcp" Description="UniFi Network Application GUI/API" Type="Port" Display="always" Required="true" Mask="false" />
  <Config Name="Hotspot Portal" Target="8444" Default="8444" Mode="tcp" Description="Secure Portal for Hotspot" Type="Port" Display="always" Required="false" Mask="false" />
  <Config Name="STUN" Target="3478" Default="3478" Mode="udp" Description="STUN for device adoption" Type="Port" Display="always" Required="true" Mask="false" />
  <Config Name="Device Discovery" Target="10003" Default="10003" Mode="udp" Description="Device discovery during adoption" Type="Port" Display="always" Required="true" Mask="false" />
  <Config Name="RTP" Target="5005" Default="5005" Mode="tcp" Description="Real-time Transport Protocol" Type="Port" Display="always" Required="false" Mask="false" />
  <Config Name="Mobile Speed Test" Target="6789" Default="6789" Mode="tcp" Description="UniFi mobile speed test" Type="Port" Display="always" Required="false" Mask="false" />
  <Config Name="Identity Hub" Target="9543" Default="9543" Mode="tcp" Description="UniFi Identity Hub" Type="Port" Display="always" Required="false" Mask="false" />
  <Config Name="cgroup (systemd)" Target="/sys/fs/cgroup" Default="/sys/fs/cgroup" Mode="rw" Description="REQUIRED: read-write cgroup mount for systemd as PID 1. Without this the container does not start unless Privileged=true." Type="Path" Display="advanced" Required="true" Mask="false">/sys/fs/cgroup</Config>
  <Config Name="Persistent Data" Target="/persistent" Default="/mnt/user/docker/unifi-os/persistent" Mode="rw" Description="Path for persistent container data" Type="Path" Display="always" Required="true" Mask="false" />
  <Config Name="Logs" Target="/var/log" Default="/mnt/user/docker/unifi-os/logs" Mode="rw" Description="Path for container logs" Type="Path" Display="always" Required="true" Mask="false" />
  <Config Name="UniFi Data" Target="/data" Default="/mnt/user/docker/unifi-os/data" Mode="rw" Description="Path for UniFi application data" Type="Path" Display="always" Required="true" Mask="false" />
  <Config Name="srv Directory" Target="/srv" Default="/mnt/user/docker/unifi-os/srv" Mode="rw" Description="Path for srv directory" Type="Path" Display="always" Required="true" Mask="false" />
  <Config Name="UniFi Library" Target="/var/lib/unifi" Default="/mnt/user/docker/unifi-os/lib-unifi" Mode="rw" Description="Path for UniFi library data" Type="Path" Display="always" Required="true" Mask="false" />
  <Config Name="PostgreSQL Library" Target="/var/lib/postgresql" Default="/mnt/user/docker/unifi-os/lib-postgresql" Mode="rw" Description="Path for PostgreSQL data (required for persistent databases)" Type="Path" Display="always" Required="true" Mask="false" />
  <Config Name="MongoDB Library" Target="/var/lib/mongodb" Default="/mnt/user/docker/unifi-os/lib-mongodb" Mode="rw" Description="Path for MongoDB data" Type="Path" Display="always" Required="true" Mask="false" />
